{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:erp-docflow:schema:promotion-decision:v1alpha",
  "title": "ERP DocFlow PromotionDecision v1alpha",
  "description": "Human decision contract. Experiment runners must never generate this document automatically.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "decision_id",
    "issue",
    "outcome",
    "experiment_manifest_ref",
    "benchmark_run_refs",
    "capability",
    "profile_ref",
    "candidate",
    "host_class",
    "eligible_environment",
    "targets",
    "fallback",
    "rollback",
    "allowed_data_classification",
    "decided_by",
    "decided_at",
    "rationale"
  ],
  "properties": {
    "schema_version": {
      "const": "promotion-decision/v1alpha"
    },
    "decision_id": {
      "$ref": "#/$defs/identifier"
    },
    "issue": {
      "type": "integer",
      "minimum": 1
    },
    "outcome": {
      "enum": [
        "PROMOTED",
        "REJECTED",
        "INCONCLUSIVE"
      ]
    },
    "experiment_manifest_ref": {
      "$ref": "#/$defs/repository_path"
    },
    "benchmark_run_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/repository_path"
      }
    },
    "capability": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "profile_ref": {
      "$ref": "#/$defs/repository_path"
    },
    "candidate": {
      "$ref": "#/$defs/candidate"
    },
    "host_class": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "eligible_environment": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "targets": {
      "$ref": "#/$defs/targets"
    },
    "fallback": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/fallback"
        }
      ]
    },
    "rollback": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/rollback"
        }
      ]
    },
    "allowed_data_classification": {
      "const": "synthetic"
    },
    "decided_by": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "decided_at": {
      "type": "string",
      "format": "date-time"
    },
    "rationale": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "PROMOTED"
          }
        },
        "required": [
          "outcome"
        ]
      },
      "then": {
        "properties": {
          "fallback": {
            "$ref": "#/$defs/fallback"
          },
          "rollback": {
            "$ref": "#/$defs/rollback"
          }
        }
      }
    }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "repository_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)(?!.*//)[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "configuration_sha256",
        "artifact_sha256",
        "license_inventory_ref"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "configuration_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "artifact_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "license_inventory_ref": {
          "$ref": "#/$defs/repository_path"
        }
      }
    },
    "targets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "met",
        "exceptions"
      ],
      "properties": {
        "met": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "exceptions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "target",
              "rationale"
            ],
            "properties": {
              "target": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "rationale": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              }
            }
          }
        }
      }
    },
    "fallback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id",
        "conditions"
      ],
      "properties": {
        "candidate_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "conditions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        }
      }
    },
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trigger_reason_codes",
        "procedure_ref"
      ],
      "properties": {
        "trigger_reason_codes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]*$"
          }
        },
        "procedure_ref": {
          "$ref": "#/$defs/repository_path"
        }
      }
    }
  }
}
