{
  "policy_id": "payable_document_pt_br/v1alpha",
  "status": "candidate",
  "dataset_manifest": "datasets/payable_document_pt_br/v1alpha/manifest.json",
  "quality_targets": {
    "manifest_sha256_coverage": 1.0,
    "ground_truth_coverage": 1.0,
    "born_digital_required_field_recoverability": 1.0,
    "classification_macro_f1_min": 0.9,
    "clean_scan_cer_max": 0.03,
    "clean_scan_key_field_exact_match_min": 0.95,
    "degraded_ocr_cer_max": 0.1,
    "failure_reason_code_accuracy": 1.0,
    "review_route_rate": 1.0,
    "auto_accept_rate": 0.0
  },
  "evaluation_protocol": {
    "integrity": {
      "population": "all manifest entries and ground-truth artifacts",
      "selector": {
        "splits": ["development", "validation", "test"]
      },
      "minimum_fixtures": 28
    },
    "born_digital_required_field_recoverability": {
      "selector": {
        "splits": ["development", "validation", "test"],
        "scenario_groups": ["BORN_DIGITAL"]
      },
      "required_fields_source": "profiles/payable_document_pt_br/v1alpha/validation-rules.json",
      "comparison": "exact normalized_value match for every required_present field",
      "aggregation": "matched required fields / eligible required fields"
    },
    "classification_macro_f1": {
      "population": "non-failure fixtures with an expected output",
      "selector": {
        "splits": ["test"],
        "exclude_scenario_groups": ["FAILURE_LIMIT"]
      },
      "aggregation_unit": "family_id",
      "minimum_families_for_conclusive_result": 20,
      "below_minimum_result": "INCONCLUSIVE"
    },
    "clean_ocr": {
      "population": "scenario_group=SCAN",
      "selector": {
        "splits": ["validation", "test"],
        "scenario_groups": ["SCAN"]
      },
      "cer_normalization": "Unicode uppercase, collapse whitespace, preserve letters and digits",
      "exact_match_fields": ["issuer_tax_id", "issued_on", "due_on", "total_amount"],
      "minimum_pages": 3
    },
    "degraded_ocr": {
      "population": "generation.parameters.degraded=true or generation.parameters.rotation is present",
      "selector": {
        "fixture_ids": [
          "dev-slip004-jpeg-deg",
          "dev-rec004-png-r090",
          "test-other001-jpeg"
        ]
      },
      "cer_normalization": "Unicode uppercase, collapse whitespace, preserve letters and digits",
      "minimum_pages": 3
    },
    "failure_reason_codes": {
      "population": "scenario_group=FAILURE_LIMIT",
      "selector": {
        "splits": ["development", "validation", "test"],
        "scenario_groups": ["FAILURE_LIMIT"]
      },
      "minimum_fixtures": 10,
      "expected_codes_source": "manifest.fixtures[].expected.reason_codes",
      "comparison": "set equality at expected.failure_stage",
      "report_each_split": true
    },
    "review_routing": {
      "selector": {
        "splits": ["development", "validation", "test"],
        "requires_expected_output": true
      },
      "expected_routing": "OPEN_REVIEW",
      "aggregation": "matching terminal routes / eligible fixtures"
    },
    "auto_accept": {
      "selector": {
        "splits": ["development", "validation", "test"]
      },
      "numerator": "terminal routing=AUTO_ACCEPT",
      "denominator": "all selected fixtures"
    },
    "latency_and_memory": {
      "warmup_runs": 1,
      "measured_runs_per_fixture": 3,
      "percentile": 0.95,
      "probe_selector": {
        "splits": ["validation", "test"],
        "exclude_scenario_groups": ["FAILURE_LIMIT"]
      },
      "ocr_selector": {
        "splits": ["validation", "test"],
        "scenario_groups": ["SCAN", "IMAGE", "HYBRID"]
      },
      "rss_measurement": "peak aggregate RSS of the isolated provider process tree, sampled at intervals no greater than 100 ms"
    }
  },
  "operational_targets": {
    "host_class": "small-cpu-lab",
    "max_parallel_heavy_jobs": 1,
    "probe_native_text_p95_seconds_per_document": 5,
    "ocr_p95_seconds_per_clean_page": 30,
    "provider_peak_rss_bytes": 4294967296,
    "gpu_required": false,
    "runtime_egress_allowed": false,
    "runtime_download_allowed": false
  },
  "decision_outcomes": [
    "RECOMMEND_PROMOTION",
    "RECOMMEND_REJECTION",
    "INCONCLUSIVE"
  ],
  "rules": [
    "A missed target cannot be silently relaxed.",
    "A small sample that cannot support the metric must produce INCONCLUSIVE.",
    "No provider is promoted without a separate human PromotionDecision.",
    "All valid and ambiguous v1alpha documents must route to human review."
  ]
}
