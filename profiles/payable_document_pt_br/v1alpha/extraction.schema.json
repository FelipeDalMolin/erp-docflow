{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:erp-docflow:profile:payable_document_pt_br:v1alpha:extraction",
  "title": "Payable document extraction v1alpha",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "document_type",
    "fields"
  ],
  "properties": {
    "schema_id": {
      "const": "payable_document"
    },
    "schema_version": {
      "const": "v1alpha"
    },
    "document_type": {
      "$ref": "#/$defs/documentTypeField"
    },
    "fields": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document_number",
        "issuer_name",
        "issuer_tax_id",
        "issued_on",
        "due_on",
        "total_amount",
        "currency"
      ],
      "properties": {
        "document_number": {
          "$ref": "#/$defs/stringField"
        },
        "issuer_name": {
          "$ref": "#/$defs/stringField"
        },
        "issuer_tax_id": {
          "$ref": "#/$defs/taxIdField"
        },
        "issued_on": {
          "$ref": "#/$defs/dateField"
        },
        "due_on": {
          "$ref": "#/$defs/dateField"
        },
        "total_amount": {
          "$ref": "#/$defs/decimalField"
        },
        "currency": {
          "$ref": "#/$defs/currencyField"
        }
      }
    }
  },
  "$defs": {
    "applicability": {
      "enum": ["PRESENT", "NOT_APPLICABLE", "MISSING", "AMBIGUOUS"]
    },
    "evidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_ref",
        "page",
        "excerpt",
        "bbox",
        "coordinate_space"
      ],
      "properties": {
        "artifact_ref": {
          "type": "string",
          "minLength": 1
        },
        "page": {
          "type": "integer",
          "minimum": 1
        },
        "excerpt": {
          "type": "string",
          "minLength": 1
        },
        "bbox": {
          "type": ["array", "null"],
          "items": {
            "type": "number",
            "minimum": 0
          },
          "minItems": 4,
          "maxItems": 4
        },
        "coordinate_space": {
          "enum": ["PIXEL", null]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "bbox": {"type": "null"}
            }
          },
          "then": {
            "properties": {
              "coordinate_space": {"type": "null"}
            }
          },
          "else": {
            "properties": {
              "coordinate_space": {"const": "PIXEL"}
            }
          }
        }
      ]
    },
    "baseField": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "raw_value",
        "normalized_value",
        "applicability",
        "evidence_refs"
      ],
      "properties": {
        "raw_value": {
          "type": ["string", "null"]
        },
        "normalized_value": {
          "type": ["string", "null"]
        },
        "applicability": {
          "$ref": "#/$defs/applicability"
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidenceRef"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "applicability": {"const": "PRESENT"}
            }
          },
          "then": {
            "properties": {
              "raw_value": {"type": "string", "minLength": 1},
              "normalized_value": {"type": "string", "minLength": 1},
              "evidence_refs": {"minItems": 1}
            }
          }
        },
        {
          "if": {
            "properties": {
              "applicability": {
                "enum": ["NOT_APPLICABLE", "MISSING"]
              }
            }
          },
          "then": {
            "properties": {
              "raw_value": {"type": "null"},
              "normalized_value": {"type": "null"},
              "evidence_refs": {"maxItems": 0}
            }
          }
        },
        {
          "if": {
            "properties": {
              "applicability": {"const": "AMBIGUOUS"}
            }
          },
          "then": {
            "properties": {
              "normalized_value": {"type": "null"},
              "evidence_refs": {"minItems": 1}
            }
          }
        }
      ]
    },
    "stringField": {
      "$ref": "#/$defs/baseField"
    },
    "documentTypeField": {
      "allOf": [
        {"$ref": "#/$defs/baseField"},
        {
          "properties": {
            "normalized_value": {
              "enum": ["INVOICE", "PAYMENT_SLIP", "RECEIPT", "OTHER"]
            },
            "applicability": {
              "const": "PRESENT"
            }
          }
        }
      ]
    },
    "taxIdField": {
      "allOf": [
        {"$ref": "#/$defs/baseField"},
        {
          "properties": {
            "normalized_value": {
              "type": ["string", "null"],
              "pattern": "^[A-Z0-9]{12}[0-9]{2}$"
            }
          }
        }
      ]
    },
    "dateField": {
      "allOf": [
        {"$ref": "#/$defs/baseField"},
        {
          "properties": {
            "normalized_value": {
              "type": ["string", "null"],
              "format": "date",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
            }
          }
        }
      ]
    },
    "decimalField": {
      "allOf": [
        {"$ref": "#/$defs/baseField"},
        {
          "properties": {
            "normalized_value": {
              "type": ["string", "null"],
              "pattern": "^(?!0+\\.00$)[0-9]+\\.[0-9]{2}$"
            }
          }
        }
      ]
    },
    "currencyField": {
      "allOf": [
        {"$ref": "#/$defs/baseField"},
        {
          "properties": {
            "normalized_value": {
              "enum": ["BRL", null]
            }
          }
        }
      ]
    }
  }
}
